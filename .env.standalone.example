# Gestor de Trabajo / Work Manager — standalone deployment
# Copy to .env.standalone and set the required values before starting.
# Empty required values intentionally make docker-compose.standalone.yml fail closed.

KCC_LOCAL_ADMIN_EMAIL=
KCC_LOCAL_ADMIN_PASSWORD=
KCC_LOCAL_AUTH_SECRET=

KCC_LOCAL_ADMIN_DISPLAY_NAME=Owner
KCC_LOCAL_LOCALE=es
KCC_LOCAL_TIMEZONE=Europe/Madrid
KCC_LOCAL_USER_ID=local-owner
KCC_LOCAL_WORKSPACE_ID=local-workspace
KCC_LOCAL_WORKSPACE_NAME=Work Manager
KCC_LOCAL_SESSION_TTL_SECONDS=43200

# Optional: required only to create/manage credential-backed integrations such as GitHub.
# Generate 32 random bytes as 64 hexadecimal characters, for example with: openssl rand -hex 32
# Keep this key outside backups and source control. Losing it makes encrypted integration credentials unreadable.
KCC_INTEGRATION_SECRET_KEY=

# Bind web/API to loopback by default. Put a TLS reverse proxy in front for remote access.
KCC_WEB_BIND_ADDRESS=127.0.0.1
KCC_WEB_PORT=3000
KCC_API_HOST_PORT=4000
KCC_WORKER_POLL_MS=5000
