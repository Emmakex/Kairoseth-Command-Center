{
  "name": "kairoseth-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Portable work and life command center by Kairoseth.",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter './packages/*' build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './packages/*' build && pnpm -r --filter './apps/*' --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.4"
  }
}
