NODE_ENV=development
KCC_API_HOST=0.0.0.0
KCC_API_PORT=4000
KCC_WEB_PORT=3000
KCC_WORKER_POLL_MS=30000
MONGODB_URI=mongodb://localhost:27017/kairoseth_command_center

# Standalone authentication. Never reuse these example values in production.
KCC_AUTH_MODE=local
KCC_LOCAL_ADMIN_EMAIL=admin@kcc.local
KCC_LOCAL_ADMIN_PASSWORD=replace-with-a-strong-password
KCC_LOCAL_AUTH_SECRET=replace-with-at-least-32-random-characters
KCC_LOCAL_ADMIN_DISPLAY_NAME=Local Owner
KCC_LOCAL_LOCALE=es
KCC_LOCAL_TIMEZONE=Europe/Madrid
KCC_LOCAL_USER_ID=local-owner
KCC_LOCAL_WORKSPACE_ID=local-workspace
KCC_LOCAL_WORKSPACE_NAME=Local Workspace
KCC_LOCAL_SESSION_TTL_SECONDS=43200

# Browser/public URL and server-to-server URL used by the Next.js application.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
KCC_API_INTERNAL_URL=http://localhost:4000
